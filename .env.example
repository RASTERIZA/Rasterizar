# ============================================================
#  Rasterizar WhatsApp Bot — configuración
#  Copia este archivo como .env y edita los valores.
# ============================================================

# Número de WhatsApp del bot, con código de país y SIN "+", espacios ni guiones.
# Perú = 51. Para 912 980 371 -> 51912980371
WA_NUMERO=51912980371

# Cómo vincular la sesión la primera vez:
#   codigo = WhatsApp te pide un código de 8 dígitos (ideal desde el celular)
#   qr     = se dibuja un QR en la terminal
WA_LOGIN=codigo

# Número desde el que das órdenes al bot.
# Déjalo vacío para usar tu propio chat "Mensajes contigo mismo" (recomendado).
WA_DUENIO=

# Modo de trabajo inicial:
#   aprobacion = el bot redacta y TE PIDE PERMISO antes de enviar  (recomendado)
#   auto       = el bot responde solo
#   manual     = el bot solo te avisa, no redacta ni responde
WA_MODO=aprobacion

# Minutos que un chat queda en silencio cuando tú respondes a mano
WA_PAUSA_MIN=60

# Responder también en grupos (1 = sí, 0 = no)
WA_GRUPOS=0

# ============================================================
#  Claude — para que redacte las cotizaciones
# ============================================================
# Saca tu clave en https://console.anthropic.com (necesita crédito prepagado,
# es aparte de tu suscripción de Claude). Sin esta clave el bot igual funciona,
# pero con respuestas de plantilla en vez de redactadas.
ANTHROPIC_API_KEY=

# Modelo. Por defecto el más capaz. Para gastar menos: claude-haiku-4-5
WA_MODELO=claude-opus-5

# Cuánto se esfuerza al redactar: low, medium, high, xhigh, max
WA_ESFUERZO=medium

# Cuántos mensajes del chat ve Claude como contexto
WA_MEMORIA=20

# Datos comerciales que van en la firma
EMPRESA_NOMBRE=Rasterizar S.A.C.
EMPRESA_CONTACTO=Jorge Luis Pampas Sarmiento
EMPRESA_TELEFONO=912980371
EMPRESA_CORREO=proyectos@rasteriza.com

# Horario de atención (24h) para el aviso fuera de hora
HORARIO_INICIO=8
HORARIO_FIN=19
